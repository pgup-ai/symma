{
  "name": "symma",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=symma-source --import tsx --test packages/*/test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "gateway": "tsx packages/gateway/src/server.ts",
    "gateway:demo": "tsx packages/gateway/src/demo.ts",
    "companion": "tsx packages/companion/src/index.ts",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
