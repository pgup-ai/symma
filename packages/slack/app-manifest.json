{
  "display_information": {
    "name": "symma",
    "description": "Reach your own coding agent, on your own machine, from Slack"
  },
  "features": {
    "bot_user": {
      "display_name": "symma",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "slash_commands": [
      {
        "command": "/connect",
        "description": "Pair a machine with symma",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "commands",
        "groups:history",
        "im:history",
        "im:write",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.im"]
    }
  }
}
