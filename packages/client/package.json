{
  "name": "@symma/client",
  "version": "0.2.1",
  "description": "Drive an ACP prompt against a local agent or one hosted by a remote companion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgup-ai/symma.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/pgup-ai/symma/tree/main/packages/client",
  "bugs": {
    "url": "https://github.com/pgup-ai/symma/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "symma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@symma/protocol": "0.1.2"
  },
  "devDependencies": {
    "@symma/gateway": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
